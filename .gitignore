# Reference copy of the previous implementation, kept locally only
entire-old-codebase/

# Python virtualenvs
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]

# Qualcomm QAIRT runtime libraries. Proprietary ("Confidential and Proprietary
# - Qualcomm Technologies, Inc." per the SDK headers) and ~16 MB of binary, so
# they are staged locally and never committed. BUILD_PLAN.md §3.4 documents how
# to obtain and stage them.
apps/android/*/src/main/jniLibs/

# Pinned third-party sources built locally (llama.cpp). The exact revision is
# recorded in docs/SCENE_MODE_VLM.md; the tree itself is not vendored.
third_party/
