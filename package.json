{
  "name": "drishti-edge",
  "version": "0.1.0",
  "private": true,
  "description": "DRISHTI Edge — dashboard, Android client, and the on-device rebuild specification",
  "workspaces": [
    "apps/dashboard",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/dashboard",
    "build": "npm run build --workspace apps/dashboard",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24"
  }
}
